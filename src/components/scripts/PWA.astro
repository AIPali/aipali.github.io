---
// src/components/scripts/PWA.astro
const baseUrl = import.meta.env.BASE_URL || '/';
const manifestUrl = `${baseUrl}manifest.webmanifest`.replace(/\/\/+/g, '/');
const swUrl = `${baseUrl}sw.js`.replace(/\/\/+/g, '/');
const iconUrl = `${baseUrl}assets/logo_192x192.png`.replace(/\/\/+/g, '/');
const offlineUrl = `${baseUrl}offline/`.replace(/\/\/+/g, '/');
---

<link rel="manifest" href={manifestUrl} />
<meta name="theme-color" content="#17181c" />
<link rel="apple-touch-icon" href={iconUrl} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="AIPali" />

<script define:vars={{ swUrl, baseUrl, offlineUrl }}>
  const hostname = window.location.hostname;
  
  // 1. 严格环境判定：仅在离线专区或本地特定环境生效
  const isOfflineDomain = hostname.includes('pwa.aipali') || 
                          hostname === 'localhost' || 
                          hostname.startsWith('192.168.');

  // 2. 根目录冷启动兜底：防止用户在地址栏手动输入根路径时看到在线版首页
  if (isOfflineDomain) {
    const path = window.location.pathname;
    if (path === baseUrl || path === baseUrl + 'index.html') {
      window.location.replace(offlineUrl);
    }
  }

  // 3. Service Worker 离线引擎：同源物理隔离注册
  if ('serviceWorker' in navigator && isOfflineDomain) {
    window.addEventListener('load', async () => {
      if (navigator.storage && navigator.storage.persist) {
        await navigator.storage.persist().catch(() => {});
      }
      navigator.serviceWorker.register(swUrl).then(() => {
        console.log('[AIPali PWA] 极致离线引擎已就绪');
      }).catch(err => {
        console.error('[AIPali PWA] 离线引擎启动失败:', err);
      });
    });
  }
</script>