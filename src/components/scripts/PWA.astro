---
// src/components/scripts/PWA.astro
const baseUrl = import.meta.env.BASE_URL || '/';
const manifestUrl = `${baseUrl}manifest.webmanifest`.replace(/\/\/+/g, '/');
const swUrl = `${baseUrl}sw.js`.replace(/\/\/+/g, '/');
const iconUrl = `${baseUrl}assets/logo_192x192.png`.replace(/\/\/+/g, '/');
const offlineUrl = `${baseUrl}offline/`.replace(/\/\/+/g, '/');
---

<link rel="manifest" href={manifestUrl} />
<meta name="theme-color" content="#17181c" />
<link rel="apple-touch-icon" href={iconUrl} />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="AIPali" />

{/* 核心脚本 1：极其轻量的首屏阻塞注入，绝对防止闪烁 */}
<script is:inline>
  (function() {
    const isEInkMode = localStorage.getItem('AIPali_EInk_Mode') === 'true';

    // 状态注入 (必须在渲染前执行，只认 localStorage)
    if (isEInkMode) {
      document.documentElement.classList.add('eink-mode');
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('starlight-theme', 'light');
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', '#ffffff');
    }
  })();
</script>

{/* 核心脚本 2：动态环境挂载 (Service Worker & 路由重定向) */}
<script define:vars={{ swUrl, baseUrl, offlineUrl }}>
  const hostname = window.location.hostname;
  const isTargetDomain = hostname.includes('aipali.github.io') || 
                         hostname === 'localhost' || 
                         hostname === '127.0.0.1' || 
                         hostname.startsWith('192.168.');
                         
  const isStandalone = window.matchMedia('(display-mode: standalone)').matches || 
                       window.navigator.standalone === true;
                       
  const isEInkMode = localStorage.getItem('AIPali_EInk_Mode') === 'true';
  const isOfflineApp = isStandalone || isEInkMode;

  // 3. 路由守护：离线应用模式下如果直接访问根目录，平滑跳转到 offline 控制台
  if (isOfflineApp) {
    const path = window.location.pathname;
    if (path === baseUrl || path === baseUrl + 'index.html') {
      window.location.replace(offlineUrl);
    }
  }

  // 4. 智能拦截左上角 Logo
  document.addEventListener('DOMContentLoaded', () => {
    const siteTitleAnchor = document.querySelector('a.site-title') || document.querySelector('.site-title a');
    
    if (siteTitleAnchor) {
      siteTitleAnchor.addEventListener('click', (e) => {
        e.preventDefault(); 
        const isMobile = window.innerWidth <= 600;
        const targetAnchor = isMobile ? '#aipali-trv' : '#aipali-nav';
        const targetBase = isOfflineApp ? offlineUrl : baseUrl; 
        
        if (window.location.pathname === targetBase || window.location.pathname === targetBase.replace(/\/$/, '')) {
          window.location.hash = targetAnchor;
        } else {
          window.location.href = targetBase + targetAnchor;
        }
      });
    }
  });

  // 5. Service Worker 动态管理
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', async () => {
      if (isTargetDomain && isOfflineApp) {
        if (navigator.storage && navigator.storage.persist) await navigator.storage.persist();
        navigator.serviceWorker.register(swUrl).then((reg) => {
          console.log(`[AIPali PWA] 离线引擎已启动 (状态: ${isEInkMode ? '墨水屏模式' : '桌面应用模式'})`);
        });
      } else {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (let reg of registrations) {
            reg.unregister().then(boolean => {
              if (boolean) console.log('[AIPali PWA] 离线引擎已注销，恢复正常实时网络');
            });
          }
        });
      }
    });
  }
</script>