---
// src/components/scripts/EInkMode.astro
---
<script is:inline>
  (function() {
    // 首屏阻塞检测：直接读取 localStorage，在渲染前完成 DOM 属性标记，杜绝 FOUC 闪烁
    const isEInkMode = localStorage.getItem('AIPali_EInk_Mode') === 'true';
    if (!isEInkMode) return;

    document.documentElement.classList.add('eink-mode');
    document.documentElement.setAttribute('data-theme', 'light');
    localStorage.setItem('starlight-theme', 'light');
    
    const themeMeta = document.querySelector('meta[name="theme-color"]');
    if (themeMeta) themeMeta.setAttribute('content', '#ffffff');

    // 墨水屏设备专属防残影优化：点击链接强制在当前页打开，禁用 target="_blank"
    window.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (link && link.target === '_blank') {
        link.removeAttribute('target');
      }
    }, true);


    /* =========================================================================
     * 【专治掌阅 iReader Ocean 5 物理按键滚动残影兼容模块】
     * -------------------------------------------------------------------------
     * 机制说明：
     * 1. 向上按键：掌阅会向屏幕正中轴线 (X ≈ 316) 注入一段 600ms 的虚拟手指滑动；
     *    -> 本模块在 touchstart 阶段直接 preventDefault 拦截，一帧动画都不给它播，
     *       直接瞬间硬刷 80%。真实手指触控不经过正中轴线，完全不受影响。
     * 2. 向下按键：掌阅会通过 Native 无障碍接口强行下发 1 秒 50 帧的平滑滚动；
     *    -> 本模块在无手势滚动的第 1 毫秒，通过锁定 overflow 瞬间打断动画，硬切 80%。
     * 
     * 📌 维护说明：将来如果更换其他设备或官方修复了此问题，将本块代码整体删除即可。
     * ========================================================================= */
    (function initIReaderOcean5Fix() {
      const STEP_RATIO = 0.8; // 翻页幅度：80% 屏高
      let isRealUserTouch = false;
      let isHardSnapping = false;
      let snapCooldownTimer = null;
      let lastScrollY = window.scrollY || document.documentElement.scrollTop;

      // 1. 拦截掌阅模拟的“向上翻页”中轴线手势（做到 0 帧位移动画，直接硬切）
      window.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        const screenCenterX = window.innerWidth / 2;

        // 掌阅特征：坐标死死卡在正中央 (X 误差 < 15px)
        const isIReaderSyntheticTouch = Math.abs(touch.clientX - screenCenterX) < 15;

        if (isIReaderSyntheticTouch) {
          // 当场枪毙模拟滑屏，杜绝任何逐帧滑动
          e.preventDefault();
          e.stopPropagation();

          const step = Math.round(window.innerHeight * STEP_RATIO);
          // 掌阅向上翻页起点在屏幕上方 (Y < 屏幕一半)
          const isUp = touch.clientY < window.innerHeight / 2;

          (document.scrollingElement || document.documentElement).scrollBy({
            top: isUp ? -step : step,
            left: 0,
            behavior: 'instant'
          });
          return;
        }

        // 真实人手操作，标记放行
        isRealUserTouch = true;
      }, { capture: true, passive: false });

      window.addEventListener('touchend', () => {
        setTimeout(() => {
          isRealUserTouch = false;
          lastScrollY = window.scrollY || document.documentElement.scrollTop;
        }, 120);
      }, { capture: true, passive: true });

      // 2. 截杀掌阅“向下翻页”的 Native 强制滚屏（第 1 毫秒秒杀动画，直接硬切）
      window.addEventListener('scroll', () => {
        const currentY = window.scrollY || document.documentElement.scrollTop;

        // 真实手指滑动或本模块硬刷中，放行
        if (isRealUserTouch || isHardSnapping) {
          if (!isHardSnapping) lastScrollY = currentY;
          return;
        }

        const diff = currentY - lastScrollY;
        if (Math.abs(diff) < 2) return;

        // 捕获到底层下发的无手势平滑动画：立即踩死刹车！
        isHardSnapping = true;
        const isDown = diff > 0;
        const step = Math.round(window.innerHeight * STEP_RATIO);
        const targetY = Math.max(0, lastScrollY + (isDown ? step : -step));
        const root = document.scrollingElement || document.documentElement;

        // 核心技巧：通过短暂置空 overflow 瞬间粉碎安卓内核正在播放的 Fling 补帧器
        root.style.overflow = 'hidden';
        root.scrollTo({ top: targetY, behavior: 'instant' });
        root.style.overflow = '';

        lastScrollY = targetY;

        // 锁定 350ms，彻底吞噬掌阅后续所有残留的插值动画帧
        clearTimeout(snapCooldownTimer);
        snapCooldownTimer = setTimeout(() => {
          isHardSnapping = false;
          lastScrollY = window.scrollY || document.documentElement.scrollTop;
        }, 350);
      }, { capture: true, passive: false });
    })();
    /* ==================== 掌阅兼容模块结束 ==================== */

  })();
</script>