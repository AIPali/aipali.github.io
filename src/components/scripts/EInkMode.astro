---
// src/components/scripts/EInkMode.astro
---
<script is:inline>
  (function() {
    // 首屏阻塞检测：直接读取 localStorage，在渲染前完成 DOM 属性标记，杜绝 FOUC 闪烁
    const isEInkMode = localStorage.getItem('AIPali_EInk_Mode') === 'true';
    if (isEInkMode) {
      document.documentElement.classList.add('eink-mode');
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('starlight-theme', 'light');
      
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', '#ffffff');

      // 墨水屏设备专属防残影优化：点击链接强制在当前页打开，禁用 target="_blank"
      window.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.target === '_blank') {
          link.removeAttribute('target');
        }
      }, true);
    }
  })();
</script>













<!-- =========================================================
     E-Ink 底层事件全量黑匣子监控台（独立诊断脚本）
========================================================= -->
<script is:inline>
  (function() {
    // 如果只想在墨水屏模式下显示，保留下面这行；如果任何模式都想测，可注释掉
    if (localStorage.getItem('AIPali_EInk_Mode') !== 'true') return;

    let seq = 0;
    let panel, logContainer, statusLine;
    let isMinimized = false;

    // 1. 初始化黑白高反差监控面板
    function initPanel() {
      if (document.getElementById('eink-blackbox-panel')) return;

      panel = document.createElement('div');
      panel.id = 'eink-blackbox-panel';
      panel.style.cssText = 'position:fixed;bottom:0;left:0;right:0;height:240px;background:#ffffff;color:#000000;border-top:3px solid #000000;z-index:2147483647;font-family:monospace;font-size:12px;display:flex;flex-direction:column;box-shadow:none;';

      // 顶部控制栏
      const header = document.createElement('div');
      header.style.cssText = 'background:#000000;color:#ffffff;padding:4px 8px;display:flex;justify-content:space-between;align-items:center;font-weight:bold;font-size:13px;';
      header.innerHTML = `
        <span>🔍 掌阅底层事件黑匣子 (视口高:${window.innerHeight}px)</span>
        <div>
          <button id="eink-bb-clear" style="background:#fff;color:#000;border:1px solid #000;padding:2px 8px;margin-right:6px;font-weight:bold;cursor:pointer;">清空</button>
          <button id="eink-bb-toggle" style="background:#fff;color:#000;border:1px solid #000;padding:2px 8px;font-weight:bold;cursor:pointer;">折叠</button>
        </div>
      `;

      // 实时滚动状态栏
      statusLine = document.createElement('div');
      statusLine.style.cssText = 'background:#eeeeee;color:#000000;padding:4px 8px;border-bottom:1px solid #000000;font-weight:bold;';
      statusLine.innerText = '等待按键或滚动触发...';

      // 历史日志滚动列表
      logContainer = document.createElement('div');
      logContainer.style.cssText = 'flex:1;overflow-y:auto;padding:6px 8px;line-height:1.4;';

      panel.appendChild(header);
      panel.appendChild(statusLine);
      panel.appendChild(logContainer);
      document.body.appendChild(panel);

      // 绑定面板自身按钮（阻止冒泡避免污染监控）
      document.getElementById('eink-bb-clear').addEventListener('click', (e) => {
        e.stopPropagation();
        logContainer.innerHTML = '';
        seq = 0;
        statusLine.innerText = '日志已清空，等待触发...';
      });

      document.getElementById('eink-bb-toggle').addEventListener('click', (e) => {
        e.stopPropagation();
        isMinimized = !isMinimized;
        panel.style.height = isMinimized ? '32px' : '240px';
        e.target.innerText = isMinimized ? '展开' : '折叠';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPanel);
    } else {
      initPanel();
    }

    // 写入一条历史日志（最新日志插在最顶部，绝不覆盖历史）
    function addLog(tag, detail, isHighlight = false) {
      if (!logContainer) initPanel();
      if (!logContainer) return;

      seq++;
      const now = new Date();
      const timeStr = `${now.getSeconds()}.${String(now.getMilliseconds()).padStart(3, '0')}s`;
      const item = document.createElement('div');
      item.style.cssText = `padding:3px 0;border-bottom:1px dashed #cccccc;${isHighlight ? 'background:#000;color:#fff;padding:4px;font-weight:bold;' : ''}`;
      item.innerHTML = `[#${seq} | ${timeStr}] <b>【${tag}】</b> ${detail}`;
      logContainer.prepend(item);
    }

    // 判断事件是否点在监控台自己身上
    function isInsidePanel(e) {
      return panel && e.target && panel.contains(e.target);
    }

    // =========================================================
    // 1. 监控所有键盘事件 (keydown / keyup / keypress)
    // =========================================================
    ['keydown', 'keyup', 'keypress'].forEach(evtName => {
      window.addEventListener(evtName, (e) => {
        addLog(
          `键盘 ${evtName}`,
          `key="<b>${e.key}</b>" | code="${e.code}" | keyCode=<b>${e.keyCode}</b> | which=${e.which} | repeat=${e.repeat} | trusted=${e.isTrusted}`,
          true
        );
      }, { capture: true, passive: true });
    });

    // =========================================================
    // 2. 监控滚轮事件 (wheel / mousewheel)
    // =========================================================
    ['wheel', 'mousewheel'].forEach(evtName => {
      window.addEventListener(evtName, (e) => {
        if (isInsidePanel(e)) return;
        addLog(
          `滚轮 ${evtName}`,
          `deltaY=<b>${Math.round(e.deltaY)}px</b> | mode=${e.deltaMode} | trusted=${e.isTrusted}`,
          true
        );
      }, { capture: true, passive: true });
    });

    // =========================================================
    // 3. 监控触摸与指针事件 (抓捕系统模拟划屏的起止坐标)
    // =========================================================
    let touchStartX = 0, touchStartY = 0, touchMoveCount = 0, touchStartTime = 0;

    window.addEventListener('touchstart', (e) => {
      if (isInsidePanel(e)) return;
      const t = e.touches[0];
      touchStartX = t ? Math.round(t.clientX) : 0;
      touchStartY = t ? Math.round(t.clientY) : 0;
      touchMoveCount = 0;
      touchStartTime = Date.now();
      addLog('触摸开始 (touchstart)', `坐标=(<b>${touchStartX}, ${touchStartY}</b>) | 触点数=${e.touches.length} | trusted=${e.isTrusted}`);
    }, { capture: true, passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isInsidePanel(e)) return;
      touchMoveCount++;
    }, { capture: true, passive: true });

    window.addEventListener('touchend', (e) => {
      if (isInsidePanel(e)) return;
      const t = e.changedTouches[0];
      const endX = t ? Math.round(t.clientX) : 0;
      const endY = t ? Math.round(t.clientY) : 0;
      const dy = endY - touchStartY;
      const dur = Date.now() - touchStartTime;
      addLog(
        '触摸结束 (touchend)',
        `起点(${touchStartX},${touchStartY}) ➔ 终点(<b>${endX},${endY}</b>) | 垂直划动=<b>${dy}px</b> | 触发move=${touchMoveCount}次 | 耗时=${dur}ms`
      );
    }, { capture: true, passive: true });

    window.addEventListener('pointerdown', (e) => {
      if (isInsidePanel(e)) return;
      addLog('指针按下 (pointerdown)', `type=<b>${e.pointerType}</b> | 坐标=(${Math.round(e.clientX)}, ${Math.round(e.clientY)}) | trusted=${e.isTrusted}`);
    }, { capture: true, passive: true });

    // =========================================================
    // 4. 监控滚动全生命周期 (统计滚动帧数、总像素、屏占比、耗时)
    // =========================================================
    let isScrolling = false;
    let scrollStartY = 0;
    let scrollStartTime = 0;
    let scrollFrames = 0;
    let scrollEndTimer = null;

    window.addEventListener('scroll', (e) => {
      if (isInsidePanel(e)) return;

      const currentY = Math.round(window.scrollY || document.documentElement.scrollTop);
      const vh = window.innerHeight;

      if (!isScrolling) {
        isScrolling = true;
        scrollStartY = currentY;
        scrollStartTime = Date.now();
        scrollFrames = 1;
        addLog('▶ 滚动开始 (scroll)', `起始位置 Y = <b>${scrollStartY}px</b>`);
      } else {
        scrollFrames++;
      }

      const deltaY = currentY - scrollStartY;
      const percent = ((Math.abs(deltaY) / vh) * 100).toFixed(1);
      const elapsed = Date.now() - scrollStartTime;

      if (statusLine) {
        statusLine.innerText = `⏳ 正在滚动: 已触发 ${scrollFrames} 帧 | 位移: ${deltaY > 0 ? '+' : ''}${deltaY}px (${percent}%屏高) | 耗时: ${elapsed}ms`;
      }

      // 若 220ms 内不再有新的 scroll 事件，视为本次滚动动画彻底结束，输出汇总报告
      clearTimeout(scrollEndTimer);
      scrollEndTimer = setTimeout(() => {
        const finalY = Math.round(window.scrollY || document.documentElement.scrollTop);
        const totalDelta = finalY - scrollStartY;
        const totalPercent = ((Math.abs(totalDelta) / vh) * 100).toFixed(1);
        const realDuration = Date.now() - scrollStartTime - 220; // 扣除等待定时器的 220ms
        const modeDesc = scrollFrames <= 2 ? '⚡ 瞬间硬切(无动画)' : `🌊 平滑滚动动画(插值了 ${scrollFrames} 帧)`;

        addLog(
          '⏹ 滚动结束汇总',
          `方向=<b>${totalDelta > 0 ? '向下 ↓' : '向上 ↑'}</b> | 总位移=<b>${totalDelta}px</b> (占屏比: <b>${totalPercent}%</b>) | 总帧数=<b>${scrollFrames}帧</b> | 动画耗时=<b>${Math.max(0, realDuration)}ms</b> | 性质: ${modeDesc}`,
          true
        );

        if (statusLine) {
          statusLine.innerText = `✅ 上次滚动: 位移 ${totalDelta}px (${totalPercent}%屏高) | 共 ${scrollFrames} 帧 | 耗时 ${Math.max(0, realDuration)}ms`;
        }
        isScrolling = false;
      }, 220);
    }, { capture: true, passive: true });

  })();
</script>