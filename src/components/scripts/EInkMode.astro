---
// src/components/scripts/EInkMode.astro
---
<script is:inline>
  (function() {
    // 首屏阻塞检测：直接读取 localStorage，在渲染前完成 DOM 属性标记，杜绝 FOUC 闪烁
    const isEInkMode = localStorage.getItem('AIPali_EInk_Mode') === 'true';
    if (isEInkMode) {
      document.documentElement.classList.add('eink-mode');
      document.documentElement.setAttribute('data-theme', 'light');
      localStorage.setItem('starlight-theme', 'light');
      
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      if (themeMeta) themeMeta.setAttribute('content', '#ffffff');

      // 墨水屏设备专属防残影优化：点击链接强制在当前页打开，禁用 target="_blank"
      window.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.target === '_blank') {
          link.removeAttribute('target');
        }
      }, true);

      // =========================================================
      // 墨水屏物理按键优化：仅监听 PageUp / PageDown，90% 瞬间硬翻
      // =========================================================
      window.addEventListener('keydown', (e) => {
        // 如果焦点在输入框或文本域中，放行默认按键行为
        const tag = e.target.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target.isContentEditable) return;

        const isNext = e.key === 'PageDown' || e.keyCode === 34;
        const isPrev = e.key === 'PageUp' || e.keyCode === 33;

        // 不是翻页键直接放行（完全不干扰音量加减、多媒体控制等）
        if (!isNext && !isPrev) return;

        // 拦截内核自带的 100% 连续平滑滚动
        e.preventDefault();

        // 翻页步长：视口高度的 90%，保留 10% 上下文防跳行
        const step = Math.round(window.innerHeight * 0.9);
        const scrollTarget = document.scrollingElement || document.documentElement;

        scrollTarget.scrollBy({
          top: isNext ? step : -step,
          left: 0,
          behavior: 'instant' // 兼容 GeckoView 与 Chromium WebView 瞬间到位
        });
      }, { passive: false });
    }
  })();
</script>