---
// src/components/scripts/EInkMode.astro
---
<script is:inline>
  (function() {
    const isEInkMode = localStorage.getItem('AIPali_EInk_Mode') === 'true';
    if (!isEInkMode) return;

    document.documentElement.classList.add('eink-mode');
    document.documentElement.setAttribute('data-theme', 'light');
    localStorage.setItem('starlight-theme', 'light');

    const themeMeta = document.querySelector('meta[name="theme-color"]');
    if (themeMeta) themeMeta.setAttribute('content', '#ffffff');

    // 链接防残影
    window.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (link && link.target === '_blank') link.removeAttribute('target');
    }, true);

    // =========================================================
    // 核心截胡逻辑：专治 Native 翻页键触发的平滑滚动
    // =========================================================
    let isUserTouching = false;
    let isSnapping = false;
    let snapCooldownTimer = null;
    let lastStableScrollTop = window.scrollY || document.documentElement.scrollTop;

    // 1. 监测用户真实手指接触（防止误伤手动触屏滑行）
    window.addEventListener('touchstart', () => { 
      isUserTouching = true; 
    }, { capture: true, passive: true });

    window.addEventListener('touchend', () => {
      setTimeout(() => {
        isUserTouching = false;
        lastStableScrollTop = window.scrollY || document.documentElement.scrollTop;
      }, 150);
    }, { capture: true, passive: true });

    // 2. 捕捉并粉碎 Native 原生滚动动画
    window.addEventListener('scroll', () => {
      const currentScrollTop = window.scrollY || document.documentElement.scrollTop;

      // 如果是手指在划，或者是我们自己触发的瞬间闪现，放行
      if (isUserTouching || isSnapping) {
        if (!isSnapping) lastStableScrollTop = currentScrollTop;
        return;
      }

      // 手指没碰屏幕，页面却开始动了 -> 100% 是按键触发的 Native 滚动
      const diff = currentScrollTop - lastStableScrollTop;
      if (Math.abs(diff) < 2) return; // 忽略微小像素抖动

      // 锁定状态，防止反复触发死循环
      isSnapping = true;

      const isDown = diff > 0;
      const step = Math.round(window.innerHeight * 0.9);
      const targetY = Math.max(0, lastStableScrollTop + (isDown ? step : -step));
      const scrollTarget = document.scrollingElement || document.documentElement;

      // 💥 致命一击：直接下发 instant 瞬间定位，强行击毙系统的平滑插值动画！
      scrollTarget.scrollTo({
        top: targetY,
        behavior: 'instant'
      });

      lastStableScrollTop = targetY;

      // 300ms 冷却时间，覆盖掉掌阅原生动画的生命周期
      clearTimeout(snapCooldownTimer);
      snapCooldownTimer = setTimeout(() => {
        isSnapping = false;
        lastStableScrollTop = window.scrollY || document.documentElement.scrollTop;
      }, 300);
    }, { capture: true, passive: true });

  })();
</script>