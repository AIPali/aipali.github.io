---
// src/components/scripts/FastGPT.astro
---
<style is:global>
  /* ====== 按钮基础样式 (默认手机端效果：仅图标) ====== */
  .fastgpt-chat-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    margin-left: 0.75rem;
    flex-shrink: 0;
    align-self: center;
    margin-top: auto;
    margin-bottom: auto;
    transition: background-color 0.2s, border-color 0.2s, opacity 0.2s;
  }

  /* 离线状态下按钮视觉降级 */
  .fastgpt-chat-btn.is-offline {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  .fastgpt-icon-container {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fastgpt-text {
    display: none;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--sl-color-text, inherit);
  }

  /* ====== PC 端效果：带外框、带文字、深浅色适配 ====== */
  @media (min-width: 50rem) {
    .fastgpt-chat-btn {
      gap: 0.5rem;
      padding: 0.125rem 0.75rem 0.125rem 0.25rem;
      border: 1px solid var(--sl-color-gray-5, #c2c6cd);
      border-radius: 999px;
    }
    
    .fastgpt-chat-btn:not(.is-offline):hover {
      background-color: var(--sl-color-gray-6, rgba(0,0,0,0.05));
    }

    .fastgpt-text {
      display: inline-block;
    }

    html[data-theme='dark'] .fastgpt-chat-btn, 
    html.dark .fastgpt-chat-btn {
      border-color: var(--sl-color-gray-5, #343841);
    }
    
    html[data-theme='dark'] .fastgpt-chat-btn:not(.is-offline):hover, 
    html.dark .fastgpt-chat-btn:not(.is-offline):hover {
      background-color: var(--sl-color-gray-6, rgba(255,255,255,0.05));
    }
  }
</style>

<script is:inline>
function embedChatbot() {
  const chatBtnId = 'fastgpt-chatbot-button';
  const targetUrl = 'https://aipali.true-dhamma.com/askai/';

  // 避免重复注入
  if (document.getElementById(chatBtnId)) return;

  const isOnline = navigator.onLine;

  // ==========================================
  // 静态 SVG 图标（外边框采用纯亮蓝绿色实体单色）
  // ==========================================
  const svgIcon = `
    <svg viewBox="0 0 80 80" style="width: 100%; height: 100%; overflow: visible;" xmlns="http://www.w3.org/2000/svg">
      <style>
        .fastgpt-icon { transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
        .fastgpt-icon:hover { transform: scale(1.05); }
        /* stroke 采用纯亮蓝绿纯色，无渐变 */
        .fastgpt-bg { fill: #ffffff; stroke: #00d4ba; stroke-width: 3.5; }
        .fastgpt-fg { stroke: #111111; fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
        @media (prefers-color-scheme: dark) {
          .fastgpt-bg { fill: #2b2b3b; }
          .fastgpt-fg { stroke: #ffffff; }
        }
        html.dark .fastgpt-bg, html[data-theme='dark'] .fastgpt-bg { fill: #2b2b3b !important; }
        html.dark .fastgpt-fg, html[data-theme='dark'] .fastgpt-fg { stroke: #ffffff !important; }
        html.light .fastgpt-bg, html[data-theme='light'] .fastgpt-bg { fill: #ffffff !important; }
        html.light .fastgpt-fg, html[data-theme='light'] .fastgpt-fg { stroke: #111111 !important; }
      </style>
      <g class="fastgpt-icon">
        <path class="fastgpt-bg" d="M40 16C26.7 16 16 26.7 16 40c0 13.3 10.7 24 24 24 4.2 0 8.1-1 11.5-2.8L62 64l-2.8-10.5C62.2 49.6 64 45 64 40c0-13.3-10.7-24-24-24z"/>
        <g class="fastgpt-fg">
          <path d="M29 50 L35 30 L41 50 M31.5 43 L38.5 43" />
          <path d="M49 30 L49 50" />
        </g>
      </g>
    </svg>
  `;

  // 1. 创建跳转链接按钮
  const ChatBtn = document.createElement('a');
  ChatBtn.id = chatBtnId;
  ChatBtn.className = 'fastgpt-chat-btn';
  ChatBtn.href = targetUrl;
  ChatBtn.target = '_blank';
  ChatBtn.rel = 'noopener noreferrer';
  if (!isOnline) ChatBtn.classList.add('is-offline');

  const ChatIconContainer = document.createElement('div');
  ChatIconContainer.className = 'fastgpt-icon-container';
  ChatIconContainer.innerHTML = svgIcon;

  const ChatText = document.createElement('span');
  ChatText.className = 'fastgpt-text';
  ChatText.innerText = isOnline ? '问经' : '离线';

  ChatBtn.appendChild(ChatIconContainer);
  ChatBtn.appendChild(ChatText);

  // 2. 插入到 Starlight Header 搜索框旁（找不到则固定右下角兜底）
  const docSearchElement = document.querySelector('.algolia-search-box');
  if (docSearchElement) {
    docSearchElement.insertAdjacentElement('afterend', ChatBtn);
  } else {
    ChatBtn.style.position = 'fixed';
    ChatBtn.style.bottom = '30px';
    ChatBtn.style.right = '30px'; 
    ChatBtn.style.zIndex = '2147483647';
    document.body.appendChild(ChatBtn);
  }

  // 3. 网络状态变化监听
  window.addEventListener('aipali:online', () => {
    ChatBtn.classList.remove('is-offline');
    ChatText.innerText = '问经';
  });

  window.addEventListener('aipali:offline', () => {
    ChatBtn.classList.add('is-offline');
    ChatText.innerText = '离线';
  });
}

function scheduleEmbedChatbot() {
  if (typeof requestIdleCallback !== 'undefined') {
    requestIdleCallback(embedChatbot, { timeout: 2000 });
  } else {
    setTimeout(embedChatbot, 0);
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', scheduleEmbedChatbot);
} else {
  scheduleEmbedChatbot();
}

// 支持 Starlight / Astro View Transitions 页面跳转
document.addEventListener('astro:page-load', () => {
  const oldBtn = document.getElementById('fastgpt-chatbot-button');
  if (oldBtn) oldBtn.remove();
  scheduleEmbedChatbot();
});
</script>