---
// src/components/AlgoliaSearch.astro
import '@docsearch/css';
---

<div class="starlight-docsearch-container algolia-search-box"></div>

<script>
  import docsearch from '@docsearch/js';

  // ============================================================
  // 离线占位按钮
  // ============================================================
  function renderOfflinePlaceholder(container: HTMLElement) {
    if (container.hasAttribute('data-initialized') || container.querySelector('.DocSearch-Button')) return;
    container.innerHTML = `
      <button class="DocSearch-Button DocSearch-Button--offline" aria-label="搜索（离线模式不可用）" disabled>
        <span class="DocSearch-Button-Container">
          <svg class="DocSearch-Search-Icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M14.386 14.386l4.088 4.088-4.088-4.088A7.533 7.533 0 1 1 3.733 3.733a7.533 7.533 0 0 1 10.653 10.653z" stroke="currentColor" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="DocSearch-Button-Placeholder">离线模式</span>
        </span>
      </button>
    `;
    container.setAttribute('data-initialized', 'offline-placeholder');
  }

  // ============================================================
  // DocSearch 初始化
  // ============================================================
  function initDocSearch() {
    const containers = document.querySelectorAll('.algolia-search-box');
    containers.forEach(container => {
      const el = container as HTMLElement;
      const status = el.getAttribute('data-initialized');
      if (status === 'true') return;
      if (status === 'offline-placeholder') { el.innerHTML = ''; el.removeAttribute('data-initialized'); }

      docsearch({
        container: el,
        appId: 'TCMTON4EX8',
        apiKey: '46fc7739c943245ddd44dac342e40493',
        indexName: 'AIPali',
        askAi: { assistantId: 'e6d00df1-00b5-4579-a17f-516973174f4f', agentStudio: true },
        translations: {
          button: { buttonText: '搜索经文或向 AI 提问 ...', buttonAriaLabel: '搜索经文' },
          modal: {
            searchBox: {
              clearButtonTitle: '清除查询', clearButtonAriaLabel: '清除查询',
              cancelButtonText: '取消', cancelButtonAriaLabel: '取消',
              closeButtonText: '关闭', closeButtonAriaLabel: '关闭',
              placeholderText: '搜索经文或向 AI 提问 ...', placeholderTextAskAi: '向 AI 提问 ...',
              placeholderTextAskAiStreaming: 'AIPali 思考中 ...', searchInputLabel: '搜索',
              backToKeywordSearchButtonText: '返回关键词搜索', backToKeywordSearchButtonAriaLabel: '返回关键词搜索',
              newConversationPlaceholder: '请输入您想问的问题 ...', conversationHistoryTitle: '我的历史对话',
              startNewConversationText: '开启新对话', viewConversationHistoryText: '查看历史对话',
              threadDepthErrorPlaceholder: '该对话深度已达上限，请开启新对话'
            },
            newConversation: {
              newConversationTitle: '我是 AIPali 助手，我能如何帮到您？',
              newConversationDescription: '您可以直接向我提问，我会基于巴利三藏为您解答，并提供出处与精准上下文。'
            },
            footer: {
              selectText: '选择', submitQuestionText: '提交问题', selectKeyAriaLabel: '回车键',
              navigateText: '切换', navigateUpKeyAriaLabel: '向上箭头', navigateDownKeyAriaLabel: '向下箭头',
              closeText: '关闭', backToSearchText: '返回搜索', closeKeyAriaLabel: '退出键',
              searchByText: '搜索由', poweredByText: 'Powered by'
            },
            startScreen: {
              recentSearchesTitle: '最近搜索', noRecentSearchesText: '暂无最近搜索记录',
              saveRecentSearchButtonTitle: '保存此搜索记录', removeRecentSearchButtonTitle: '删除此搜索记录',
              favoriteSearchesTitle: '已收藏的搜索记录', removeFavoriteSearchButtonTitle: '取消收藏此搜索',
              recentConversationsTitle: '最近对话', removeRecentConversationButtonTitle: '删除此对话'
            },
            errorScreen: { titleText: '无法获取结果', helpText: '请检查您的网络连接是否正常。' },
            noResultsScreen: {
              noResultsText: '无法找到相关结果：', suggestedQueryText: '您可以尝试搜索：',
              reportMissingResultsText: '您认为这里应该有结果？', reportMissingResultsLinkText: '点击反馈'
            },
            resultsScreen: { askAiPlaceholder: '向 AI 提问：', noResultsAskAiPlaceholder: '没搜到？让 AI 帮您找：' },
            askAiScreen: {
              disclaimerText: 'AI 的回答可能出错，请以经文原文为准。', relatedSourcesText: '相关来源',
              thinkingText: '正在思考中 ...', copyButtonText: '复制', copyButtonCopiedText: '已复制！', copyButtonTitle: '复制',
              likeButtonTitle: '赞', dislikeButtonTitle: '踩', afterToolCallText: '为您搜索了'
            }
          }
        }
      });
      el.setAttribute('data-initialized', 'true');
    });
  }

  // ============================================================
  // AI 文本碎片拦截翻译
  // ============================================================
  function setupAskAITranslator() {
    if ((window as any).__aipali_translator_setup) return;
    (window as any).__aipali_translator_setup = true;
    const translateNode = (node: Node) => {
      if (node.nodeType === Node.TEXT_NODE && node.nodeValue) {
        let val = node.nodeValue;
        let changed = false;
        if (/searching/i.test(val)) { val = val.replace(/searching/ig, '正在搜索'); changed = true; }
        if (/found/i.test(val)) { val = val.replace(/found/ig, '共找到'); changed = true; }
        if (/results?/i.test(val)) { val = val.replace(/results?/ig, '项结果'); changed = true; }
        if (changed) node.nodeValue = val;
      }
    };
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'characterData') translateNode(mutation.target);
        else if (mutation.type === 'childList') {
          mutation.addedNodes.forEach((node) => {
            translateNode(node);
            if (node.nodeType === Node.ELEMENT_NODE) {
              const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT);
              let textNode;
              while ((textNode = walker.nextNode())) translateNode(textNode);
            }
          });
        }
      });
    });
    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
  }

  // ============================================================
  // [终极修复] VDOM-Safe 镜像渲染引擎 (告别假死与吞字)
  // ============================================================
  function setupAskAIThinkingHandler() {
    if ((window as any).__aipali_thinking_setup) return;
    (window as any).__aipali_thinking_setup = true;

    // 1. 全局事件委托：捕获用户折叠操作
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const summary = target.closest('.starlight-think-summary');
      if (!summary) return;
      const details = summary.closest('details.starlight-think-block') as HTMLDetailsElement | null;
      if (!details) return;
      const parentMsg = details.closest('.DocSearch-AskAiScreen-Message') || details.parentElement;
      if (!parentMsg) return;
      setTimeout(() => {
        if (details.open) parentMsg.removeAttribute('data-user-collapsed');
        else parentMsg.setAttribute('data-user-collapsed', 'true');
      }, 0);
    });

    let isMutating = false;

    const processContainer = (container: HTMLElement) => {
      // 安全锁：遇到自己生成的镜像替身，直接跳过
      if (container.classList.contains('aipali-mirror')) return;

      let rawHtml = container.innerHTML;

      // 【核心修正】：检测当前文本中是否存在任何形式的 think 标签 (大写、小写、转义)
      const hasThinkTrace = /(&lt;|<)think(&gt;|>)/i.test(rawHtml);

      if (!hasThinkTrace) {
        // 兜底恢复机制：如果大模型尚未输出 think，或已输出完毕被冲刷，恢复原始容器显示
        const parentMsg = container.closest('.DocSearch-AskAiScreen-Message') || container.parentElement;
        if (parentMsg) {
          const existingMirror = parentMsg.querySelector('.aipali-mirror') as HTMLElement;
          if (existingMirror) existingMirror.style.display = 'none';
          container.style.display = '';
        }
        return;
      }

      // 【终极归一化】：无论 DOM 怎么转义，全部强制归一化为标准的 <think> 标签，百分百匹配后续正则
      rawHtml = rawHtml.replace(/(&lt;|<)think(&gt;|>)/gi, '<think>')
                       .replace(/(&lt;|<)\/think(&gt;|>)/gi, '</think>');

      const parentMsg = container.closest('.DocSearch-AskAiScreen-Message') || container.parentElement;
      if (!parentMsg) return;

      // 寻找或创建一个独立的替身容器 (Mirror)
      let mirror = parentMsg.querySelector('.aipali-mirror') as HTMLElement;
      if (!mirror) {
        mirror = document.createElement('div');
        mirror.className = container.className + ' aipali-mirror';
        parentMsg.insertBefore(mirror, container.nextSibling);
      }

      // 让原生容器隐身，激活替身
      container.style.display = 'none'; 
      mirror.style.display = '';

      // 获取用户折叠记忆
      const isUserCollapsed = parentMsg.getAttribute('data-user-collapsed') === 'true';
      const openAttr = isUserCollapsed ? '' : 'open';
      const SVG_ICON = `<svg class="starlight-think-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>`;

      let processedHtml = rawHtml;

      // 1. 替换已闭合的思考块 (优先匹配)
      processedHtml = processedHtml.replace(
        /<think>([\s\S]*?)<\/think>/gi,
        (match, p1) => `<details class="starlight-think-block" ${openAttr}><summary class="starlight-think-summary">${SVG_ICON}<span class="starlight-think-title">思考过程</span></summary><div class="starlight-think-content">${p1}</div></details>`
      );

      // 2. 替换流式传输中尚未闭合的思考块 (补漏匹配)
      if (processedHtml.includes('<think>')) {
        processedHtml = processedHtml.replace(
          /<think>([\s\S]*)$/gi,
          (match, p1) => `<details class="starlight-think-block" ${openAttr}><summary class="starlight-think-summary">${SVG_ICON}<span class="starlight-think-title">AIPali 思考中 ...</span></summary><div class="starlight-think-content">${p1}</div></details>`
        );
      }

      mirror.innerHTML = processedHtml;
    };

    const scanAndProcess = () => {
      if (isMutating) return;
      isMutating = true;
      try {
        const askAiModal = document.querySelector('.DocSearch-Modal');
        if (!askAiModal) return;
        // 抓取所有回答内容的容器，避开替身
        const contents = askAiModal.querySelectorAll('.DocSearch-AskAiScreen-MessageContent:not(.aipali-mirror), [class*="MessageContent"]:not(.aipali-mirror)');
        contents.forEach(el => processContainer(el as HTMLElement));
      } finally {
        setTimeout(() => { isMutating = false; }, 30);
      }
    };

    const observer = new MutationObserver(() => scanAndProcess());
    observer.observe(document.body, { childList: true, subtree: true, characterData: true });
  }

  // ============================================================
  // 划词唤醒 AI 核心功能
  // ============================================================
  function setupTextSelectionAskAI() {
    if ((window as any).__aipali_selection_setup) return;
    (window as any).__aipali_selection_setup = true;

    let popup = document.getElementById('aipali-selection-popup');
    if (!popup) {
      popup = document.createElement('button');
      popup.id = 'aipali-selection-popup';
      popup.className = 'aipali-ask-ai-popup';
      popup.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
        <span>AI 解读</span>
      `;
      document.body.appendChild(popup);

      popup.addEventListener('mousedown', (e) => {
        e.preventDefault();
        const selection = window.getSelection();
        if (selection && selection.toString().trim().length > 1) {
          triggerAlgoliaAskAI(selection.toString().trim());
        }
        hidePopup();
      });
    }

    function hidePopup() { if (popup) popup.classList.remove('show'); }

    const handleSelection = () => {
      setTimeout(() => {
        const hasSidebar = !!document.querySelector('.sidebar-content') || 
                            !!document.getElementById('starlight__sidebar') || 
                            !!document.querySelector('aside#sidebar');
        if (!hasSidebar) { hidePopup(); return; }

        const selection = window.getSelection();
        if (!selection || selection.isCollapsed) { hidePopup(); return; }

        const text = selection.toString().trim();
        if (text.length <= 1) { hidePopup(); return; }

        let node = selection.anchorNode as HTMLElement | null;
        let isInsideContent = false;
        while (node) {
          if (node.nodeType === 1 && node.classList && node.classList.contains('sl-markdown-content')) {
            isInsideContent = true; break;
          }
          node = node.parentElement;
        }

        if (!isInsideContent) { hidePopup(); return; }

        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        if (popup) {
            popup.style.left = `${rect.left + (window.scrollX || document.documentElement.scrollLeft) + (rect.width / 2)}px`;
            popup.style.top = `${rect.bottom + (window.scrollY || document.documentElement.scrollTop) + 12}px`; 
            popup.classList.add('show');
        }
      }, 50);
    };

    document.addEventListener('mouseup', handleSelection);
    document.addEventListener('touchend', handleSelection);
    document.addEventListener('keyup', handleSelection);
    document.addEventListener('mousedown', (e) => {
      if (popup && e.target !== popup && !popup.contains(e.target as Node)) hidePopup();
    });
    document.addEventListener('scroll', () => {
       if (popup && popup.classList.contains('show')) hidePopup();
    }, { passive: true });
  }

  function triggerAlgoliaAskAI(query: string) {
    const docSearchBtn = document.querySelector('.DocSearch-Button') as HTMLElement;
    if (!docSearchBtn) return;
    docSearchBtn.click();

    let checkInputCount = 0;
    const checkInputInterval = setInterval(() => {
      const input = document.querySelector('.DocSearch-Input') as HTMLInputElement;
      if (input) {
        clearInterval(checkInputInterval);
        const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value')?.set;
        if (nativeInputValueSetter) nativeInputValueSetter.call(input, query);
        else input.value = query;
        
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));

        let checkAskAICount = 0;
        const checkAskAIInterval = setInterval(() => {
          const askAiContainer = document.querySelector('.DocSearch-Hit--AskAI');
          if (askAiContainer) {
            const clickable = (askAiContainer.querySelector('a') || askAiContainer.querySelector('button') || askAiContainer) as HTMLElement;
            if (clickable) { clickable.click(); clearInterval(checkAskAIInterval); }
          }
          if (checkAskAICount++ > 30) clearInterval(checkAskAIInterval);
        }, 100);
      }
      if (checkInputCount++ > 30) clearInterval(checkInputInterval);
    }, 50);
  }

  function scheduleIdle(fn: () => void) {
    if (typeof requestIdleCallback !== 'undefined') requestIdleCallback(fn, { timeout: 3000 });
    else setTimeout(fn, 0);
  }

  function mountSearchComponent() {
    scheduleIdle(() => {
      if (navigator.onLine) {
        initDocSearch();
        setupAskAITranslator();
        setupAskAIThinkingHandler(); 
      } else {
        document.querySelectorAll('.algolia-search-box').forEach(container => {
          renderOfflinePlaceholder(container as HTMLElement);
        });
      }
      setupTextSelectionAskAI();
    });
  }

  function setupNetworkListeners() {
    if ((window as any).__aipali_network_listener_setup) return;
    (window as any).__aipali_network_listener_setup = true;

    window.addEventListener('online', () => {
      scheduleIdle(() => {
        initDocSearch(); setupAskAITranslator(); setupAskAIThinkingHandler();
        window.dispatchEvent(new CustomEvent('aipali:online'));
      });
    });
    window.addEventListener('offline', () => window.dispatchEvent(new CustomEvent('aipali:offline')) );
  }

  mountSearchComponent();
  setupNetworkListeners();
  document.addEventListener('astro:page-load', mountSearchComponent);
</script>

<style is:global>
  .DocSearch-Container {
    backdrop-filter: none !important; -webkit-backdrop-filter: none !important;
    background-color: var(--docsearch-container-background) !important;
    z-index: 9999 !important; box-sizing: border-box !important;
  }
  .DocSearch-Container * { box-sizing: border-box !important; }
  .DocSearch-Form { margin: 0 !important; }
  .DocSearch-Modal { max-height: 85vh !important; }

  .DocSearch-Button--offline { opacity: 0.5; cursor: not-allowed !important; pointer-events: none; }

  :root[data-theme='light'] {
    --docsearch-container-background: rgba(101, 108, 133, 0.8); --docsearch-modal-background: #f5f6f7; 
    --docsearch-modal-shadow: 0 4px 24px rgba(0, 0, 0, 0.1); --docsearch-searchbox-background: #ffffff;
    --docsearch-searchbox-focus-background: #ffffff; --docsearch-hit-background: #ffffff;
    --docsearch-hit-color: var(--sl-color-gray-2); --docsearch-hit-shadow: 0 1px 3px 0 rgba(0,0,0,0.08);
    --docsearch-hit-hover-background: var(--sl-color-accent); --docsearch-hit-hover-color: #ffffff;
    --docsearch-highlight-color: var(--sl-color-accent); --docsearch-primary-color: var(--sl-color-accent);
    --docsearch-logo-color: var(--sl-color-accent); --docsearch-text-color: #121212;
    --aipali-think-bg: rgba(0, 0, 0, 0.025); --aipali-think-border: var(--sl-color-gray-5);
    --aipali-think-accent: var(--sl-color-accent); --aipali-think-text: var(--sl-color-gray-2);
  }

  :root, :root[data-theme='dark'] {
    --docsearch-container-background: rgba(0, 0, 0, 0.6); --docsearch-modal-background: var(--sl-color-gray-6); 
    --docsearch-modal-shadow: inset 1px 1px 0 0 var(--sl-color-gray-5), 0 3px 8px 0 rgba(0,0,0,0.5);
    --docsearch-searchbox-background: var(--sl-color-black); --docsearch-searchbox-focus-background: var(--sl-color-black);
    --docsearch-searchbox-shadow: inset 0 0 0 1px var(--sl-color-gray-5); --docsearch-hit-background: var(--sl-color-black); 
    --docsearch-hit-color: var(--sl-color-gray-2); --docsearch-hit-shadow: none;
    --docsearch-hit-hover-background: var(--sl-color-accent-high); --docsearch-hit-hover-color: #121212;
    --docsearch-highlight-color: var(--sl-color-accent-high); --docsearch-primary-color: var(--sl-color-accent-high);
    --docsearch-logo-color: var(--sl-color-accent-high); --docsearch-text-color: #ffffff;
    --docsearch-muted-color: var(--sl-color-gray-3);
    --aipali-think-bg: rgba(255, 255, 255, 0.03); --aipali-think-border: var(--sl-color-gray-5);
    --aipali-think-accent: var(--sl-color-accent-high); --aipali-think-text: var(--sl-color-gray-3);
  }

  [data-theme='dark'] .DocSearch-Hit--AskAI { background: #1b1b1f !important; border: 1px solid var(--sl-color-gray-5); }
  :root[data-theme='dark'] .DocSearch-Input, :root[data-theme='dark'] .DocSearch-Input::placeholder { color: #ffffff !important; }
  :root[data-theme='dark'] .DocSearch-Logo svg path, :root[data-theme='dark'] .DocSearch-Logo svg rect { fill: var(--docsearch-logo-color) !important; }

  .starlight-docsearch-container { display: flex; align-items: center; flex-grow: 1; justify-content: flex-start; min-width: 0; }
  .starlight-docsearch-container .DocSearch-Button { display: flex; align-items: center; margin: 0; border-radius: 0.5rem; background-color: transparent; border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-gray-2); height: 2.5rem; padding: 0 0.75rem; transition: color 0.2s, border-color 0.2s; width: auto; max-width: 100%; gap: 0.5rem; }
  .starlight-docsearch-container .DocSearch-Button-Placeholder { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .starlight-docsearch-container .DocSearch-Search-Icon, .starlight-docsearch-container .DocSearch-Button-Keys { flex-shrink: 0; }
  .starlight-docsearch-container .DocSearch-Button:hover, .starlight-docsearch-container .DocSearch-Button:focus { border-color: var(--sl-color-gray-4); color: var(--sl-color-text); box-shadow: none; outline: none; }

  @media (max-width: 50rem) {
    .starlight-docsearch-container .DocSearch-Button { border: none; padding: 0; width: 2.5rem; justify-content: center; }
    .starlight-docsearch-container .DocSearch-Button-Keys, .starlight-docsearch-container .DocSearch-Button-Placeholder { display: none; }
    .starlight-docsearch-container .DocSearch-Button .DocSearch-Search-Icon { width: 1.2rem; height: 1.2rem; }
  }

  .DocSearch-Modal .DocSearch-Form { display: flex !important; align-items: center !important; }
  .DocSearch-Modal .DocSearch-Input { -webkit-appearance: none !important; appearance: none !important; margin: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; line-height: normal !important; }
  .DocSearch-Modal .DocSearch-MagnifierLabel, .DocSearch-Modal .DocSearch-Reset { display: flex !important; align-items: center !important; justify-content: center !important; margin-top: 0 !important; margin-bottom: 0 !important; }
  .DocSearch-Modal .DocSearch-MagnifierLabel svg, .DocSearch-Modal .DocSearch-Reset svg { display: block !important; vertical-align: middle !important; }
  .DocSearch-Hit mark { color: var(--docsearch-highlight-color) !important; background-color: transparent !important; font-weight: bold; }
  .DocSearch-Hit[aria-selected='true'] a { background-color: var(--docsearch-hit-hover-background) !important; box-shadow: none !important; }
  .DocSearch-Hit[aria-selected='true'] a *, .DocSearch-Hit[aria-selected='true'] a mark { color: var(--docsearch-hit-hover-color) !important; }
  .DocSearch-Modal .prose a, .DocSearch-Modal a[class*="askAi"], .DocSearch-Modal[data-testid="ask-ai-source"] { color: var(--docsearch-highlight-color) !important; }
  .DocSearch-AskAiScreen-MessageContent-Tool.Tool--Result { font-size: 0.8rem !important; color: var(--docsearch-muted-color) !important; }

  /* =========================================================
     [核心修正]：利用纯 CSS 强制隐藏 Tool Call 中的 think
     因为 mirror 完美继承了原生容器的 class，一旦处于 Tool 里，即刻隐身！
     ========================================================= */
  .DocSearch-AskAiScreen-MessageContent-Tool .starlight-think-block,
  .Tool--Result .starlight-think-block {
    display: none !important;
  }

  /* 思考过程组件样式 */
  .starlight-think-block {
    margin: 0.75rem 0 1rem 0 !important;
    border: 1px solid var(--aipali-think-border) !important;
    border-left: 3px solid var(--aipali-think-accent) !important;
    border-radius: 0.375rem !important;
    background-color: var(--aipali-think-bg) !important;
    overflow: hidden !important;
    transition: border-color 0.2s ease, background-color 0.2s ease !important;
  }

